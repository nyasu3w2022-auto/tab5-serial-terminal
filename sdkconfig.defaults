# Target: ESP32-P4
CONFIG_IDF_TARGET="esp32p4"

# Chip revision: TAB5 early lot uses ESP32-P4 v1.0
# ESP32-P4 rev <3.0 and >=3.0 are mutually exclusive hardware families.
# Must enable SELECTS_REV_LESS_V3 to unlock the v0.x/v1.x choices.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESP32P4_REV_MIN_FULL=100
CONFIG_ESP32P4_REV_MAX_FULL=199

# Flash size
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y

# CPU frequency
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_400=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# LVGL
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_UNSCII_8=y

# Log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Partition table
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# C++ exceptions (required by VCP driver .hpp classes)
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_EXCEPTIONS_EMG_POOL_SIZE=0

# USB Host
CONFIG_USB_HOST_TASK_PRIORITY=20
CONFIG_USB_HOST_HW_BUFFER_BIAS_BALANCED=y
